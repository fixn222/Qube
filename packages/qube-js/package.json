{
  "name": "qube-js",
  "version": "1.0.0",
  "description": "The official javaScript SDK for qube",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "demo": "pnpm build && python3 -m http.server ${DEMO_PORT:-4173}"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@qube/constants": "workspace:*",
    "socket.io-client": "^4.8.3",
    "uploadthing": "^7.7.4"
  },
  "devDependencies": {
    "@qube/types": "workspace:*",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  }
}
