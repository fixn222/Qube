# Copy to .qube/.env and replace values. Protect the real file with chmod 600.
# The installer generates the four application signing secrets.
DATABASE_URL='postgresql://user:percent-encoded-password@host/database?sslmode=require'
REALTIME_DATABASE_URL=''

# Both ports are localhost-bound by Compose and belong to the same container.
# API_URL is internal to the container and is set automatically by Compose.
WEB_HOST_PORT=3001
API_HOST_PORT=3000
WEB_URL=http://localhost:3001
PUBLIC_API_URL=http://localhost:3000/api

JWT_ACCESS_SECRET=generate-a-unique-random-secret
JWT_REFRESH_SECRET=generate-a-different-random-secret
PROJECT_JWT_SECRET=generate-another-random-secret
INVITE_SECRET=generate-another-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Optional integrations. Callback URLs must match the OAuth provider settings.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback
RESEND_API_KEY=
UPLOADTHING_TOKEN=
